+def is_study_access_account_request(text: str) -> bool:
+    """Return whether a DingTalk text belongs to the allowed Study Access workflow."""
+    normalized = re.sub(r"\s+", " ", text or "").strip()
+    return bool(normalized) and any(
+        pattern.search(normalized) for pattern in _STUDY_ACCESS_ACCOUNT_REQUEST_PATTERNS
+    )
+
+
+def classify_study_access_capability(text: str) -> Optional[str]:
+    """Classify an allowed DingTalk request into one business capability.
+
+    This is the first half of the allowlist.  Returning ``None`` means the
+    request must be answered locally and must never reach the agent runtime.
+    The gateway independently validates the returned capability before it
+    exposes any tools.
+    """
+    normalized = re.sub(r"\s+", " ", text or "").strip()
+    if not normalized:
+        return None
+
+    if re.search(r"^/approve(?:\s|$)", normalized, re.IGNORECASE):
+        return "approval"
+    if not is_study_access_account_request(normalized):
+        return None
+    _has_business_object = re.search(
+        r"(?:账号|账户|帐户|用户|中心|site|study_api|role_api|excel|附件|模板|申请表|表格|邮件|邮箱)",
+        normalized,
+        re.IGNORECASE,
+    )
+    _has_business_action = re.search(
+        r"(?:申请|开通|创建|新增|更新|修改|变更|禁用|停用|删除|分配|授权|权限|角色|"
+        r"审批|确认|处理|导入|解析|校验|预览|检查|查询|状态|结果|失败|问题|未创建|登录|回复)",
+        normalized,
+        re.IGNORECASE,
+    )
+    if not (_has_business_object and _has_business_action):
+        return None
+    if re.search(r"(?:excel|附件|模板|申请表|表格)", normalized, re.IGNORECASE):
+        return "excel_process"
+    if re.search(r"(?:中心|site)", normalized, re.IGNORECASE):
+        return "center_manage"
+    if re.search(r"(?:禁用|停用|删除)", normalized, re.IGNORECASE):
+        return "account_disable"
+    if re.search(r"(?:更新|修改|变更)", normalized, re.IGNORECASE):
+        return "account_update"
+    if (
+        re.search(r"(?:状态|结果|失败|问题|未创建|为什么|查询)", normalized, re.IGNORECASE)
+        and not re.search(r"(?:重新|再次).{0,6}(?:创建|开通)", normalized, re.IGNORECASE)
+    ):
+        return "result_support"
+    if re.search(r"(?:申请|开通|创建|新增)", normalized, re.IGNORECASE):
+        return "account_create"
+    if re.search(r"(?:权限|角色|study_api|role_api)", normalized, re.IGNORECASE):
+        return "permission_assign"
+    return "result_support"
+
+
+def get_dingtalk_local_scope_reply(text: str) -> Optional[str]:
+    """Return deterministic replies that must not reach the general model."""
+    normalized = re.sub(r"\s+", " ", text or "").strip()
+    if not normalized:
+        return DINGTALK_SCOPE_REPLY
+    if _DINGTALK_CAPABILITIES_RE.search(normalized):
+        return DINGTALK_CAPABILITIES_REPLY
+    if _DINGTALK_GREETING_RE.fullmatch(normalized):
+        return DINGTALK_GREETING_REPLY
+    return None
+
+
+def get_dingtalk_privacy_refusal(text: str) -> Optional[str]:
+    """Return a privacy refusal when sensitive intent is detected."""
+    normalized = re.sub(r"\s+", " ", text or "").strip()
+    _business_mailbox_request = bool(
+        re.search(r"(?:邮件|邮箱|mailbox|email)", normalized, re.IGNORECASE)
+        and re.search(r"(?:账号申请|账户申请|申请表|附件|excel|处理|检查|审批)", normalized, re.IGNORECASE)
+        and not re.search(r"(?:用户|客户|个人|某人).{0,8}(?:邮件|邮箱|email)", normalized, re.IGNORECASE)
+    )
+    for index, (pattern, replies) in enumerate(_DINGTALK_PRIVACY_REFUSALS):
+        # The third rule protects personal data. Checking the dedicated agent
+        # mailbox for account-application work is an allowed business action,
+        # not a request to disclose a user's email address.
+        if index == 2 and _business_mailbox_request:
+            continue
+        if pattern.search(normalized):
+            return replies[sum(normalized.encode("utf-8")) % len(replies)]
+    return None
+
