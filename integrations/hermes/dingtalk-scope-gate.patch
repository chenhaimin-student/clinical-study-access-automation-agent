+    async def _send_policy_reply(
+        self,
+        chat_id: str,
+        content: str,
+        message_id: str,
+    ) -> SendResult:
+        """Send a local gate response as plain text and verify DingTalk's body.
+
+        DingTalk can return HTTP 200 with a non-zero ``errcode``.  The normal
+        markdown path historically treated every 2xx as success, which could
+        leave a blocked request with Thinking/Done reactions but no visible
+        text.  Policy replies use the simplest text payload, validate the JSON
+        result, and fall back to the regular sender when necessary.
+        """
+        webhook_info = self._get_valid_webhook(chat_id)
+        if not webhook_info or not self._http_client:
+            result = await self.send(chat_id, content, reply_to=message_id)
+            if not result.success:
+                logger.error(
+                    "[%s] DingTalk policy reply failed chat_id=%s error=%s",
+                    self.name,
+                    chat_id,
+                    result.error,
+                )
+            return result
+
+        session_webhook, _ = webhook_info
+        try:
+            resp = await self._http_client.post(
+                session_webhook,
+                json={"msgtype": "text", "text": {"content": content}},
+                timeout=15.0,
+            )
+            try:
+                body = resp.json()
+            except Exception:
+                body = {}
+            errcode = body.get("errcode") if isinstance(body, dict) else None
+            if resp.status_code < 300 and errcode in (None, 0, "0"):
+                logger.info(
+                    "[%s] DingTalk policy reply delivered msg_id=%s",
+                    self.name,
+                    message_id,
+                )
+                self._fire_done_reaction(chat_id)
+                return SendResult(success=True, message_id=uuid.uuid4().hex[:12])
+            logger.warning(
+                "[%s] DingTalk plain policy reply rejected HTTP %s body=%s",
+                self.name,
+                resp.status_code,
+                str(body or resp.text)[:300],
+            )
+        except Exception as exc:
+            logger.warning("[%s] DingTalk plain policy reply error: %s", self.name, exc)
+
+        result = await self.send(chat_id, content, reply_to=message_id)
+        if not result.success:
+            logger.error(
+                "[%s] DingTalk policy reply fallback failed chat_id=%s error=%s",
+                self.name,
+                chat_id,
+                result.error,
+            )
+        return result
