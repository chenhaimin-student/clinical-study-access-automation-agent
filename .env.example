# Mail intake
AGENT_EMAIL_ADDRESS=
AGENT_EMAIL_PASSWORD=
AGENT_IMAP_HOST=imap.example.invalid
AGENT_IMAP_PORT=993
AGENT_SMTP_HOST=smtp.example.invalid
AGENT_SMTP_PORT=465

# Generic service adapters
STUDY_BASE_URL=https://study-api.example.invalid
ROLE_BASE_URL=https://role-api.example.invalid
STUDY_ACCESS_STUDY_USERNAME=
STUDY_ACCESS_STUDY_PASSWORD=
STUDY_ACCESS_ROLE_USERNAME=
STUDY_ACCESS_ROLE_PASSWORD=

# Workflow safety defaults
STUDY_ACCESS_EMAIL_MODE=preview
STUDY_ACCESS_EMAIL_AUTO_APPLY=0
STUDY_ACCESS_EMAIL_PROCESS_APPROVALS=0
STUDY_ACCESS_EMAIL_SEND_PREVIEW=0
STUDY_ACCESS_EMAIL_SEND_RESULT=0
STUDY_ACCESS_EMAIL_LIVE_PREVIEW=0
STUDY_ACCESS_EMAIL_JOB_DIR=.runtime/jobs
STUDY_ACCESS_EMAIL_OUTBOX_DIR=.runtime/outbox
STUDY_ACCESS_EMAIL_SCOPE=both
STUDY_ACCESS_PROJECT_ROUTES={}
STUDY_ACCESS_SUPPORT_EMAILS=support@example.test
STUDY_ACCESS_REPLY_EXCLUDED_EMAILS=access.agent@example.test

# Optional Agent notification channel
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# Optional policy-model classification. Disabled by default.
STUDY_ACCESS_EMAIL_POLICY_MODEL_ENABLED=0
STUDY_ACCESS_EMAIL_POLICY_BASE_URL=https://model-api.example.invalid
STUDY_ACCESS_EMAIL_POLICY_API_KEY=
STUDY_ACCESS_EMAIL_POLICY_MODEL=
